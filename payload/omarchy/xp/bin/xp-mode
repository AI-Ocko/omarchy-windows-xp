#!/bin/bash
# xp-mode on|off|status|browser-dark|cleanup -- apply or fully revert the Windows XP side effects
# that an Omarchy theme cannot carry by itself. Called by
# ~/.config/omarchy/hooks/theme-set.d/windows-xp after every `omarchy theme set`.
#
#   on      First call saves the pre-XP state to saved-state.json, then applies.
#           Later calls (switching blue -> olive) only re-apply; never re-save.
#   off     Restores from saved-state.json, removes what `on` installed, deletes
#           the saved state. With nothing saved and nothing installed it returns
#           before forking anything.
#   status  "on" or "off" plus a short summary.
#   sizes   Re-apply only the sizes step (XP terminal font from Omarchy's text
#           size); a no-op outside XP. Run by systemd/user/xp-sizes.path.
#   browser-dark on|off|status
#           Dark mode for Zen, Chromium and Chrome under the XP themes (on by
#           default). Saved as the user's setting; re-applied at once while
#           an XP theme is active. See the browser step.
#   cleanup Finish a Zen clean-up left pending because Zen was running (the
#           browser step); a no-op without one. Run by post-boot.d at login.
#
# The hook's stdout is discarded, so errors go to stderr AND to $LOG.
#
# Adding a step: define <name>_save (print a JSON value, `null` if nothing to
# save), <name>_apply and <name>_restore (gets that saved JSON as $1), then
# append <name> to STEPS. Each step is run and logged independently; `off`
# keeps saved-state.json if any restore failed so a rerun can finish the job.

STEPS=(gsettings hypr shell tmux files sizes browser)

SCHEMA=org.gnome.desktop.interface
STATE_DIR=$HOME/.local/state/omarchy/xp
SAVED=$STATE_DIR/saved-state.json
LOG=$STATE_DIR/xp-mode.log
THEME_NAME_FILE=$HOME/.local/state/omarchy/current/theme.name
TOGGLE=$HOME/.local/state/omarchy/toggles/hypr/windows-xp.lua
LATE=${BASH_SOURCE[0]%/*}/../hypr/late.lua
SHELL_JSON=$HOME/.config/omarchy/shell.json
THEME_DIR=$HOME/.local/state/omarchy/current/theme
XP_DIR=$(cd "${BASH_SOURCE[0]%/*}/.." && pwd)

log() {
  local line
  printf -v line '%(%F %T)T xp-mode %s: %s' -1 "$CMD" "$*"
  echo "$line" >&2
  mkdir -p "$STATE_DIR" && echo "$line" >>"$LOG"
}

xp_theme_active() {
  local name=""
  [[ -r $THEME_NAME_FILE ]] && read -r name <"$THEME_NAME_FILE"
  [[ $name == windows-xp || $name == windows-xp-* ]]
}

# ---------------------------------------------------------------- gsettings
# All seven keys are recorded, but only the ones XP sets are restored.
# gtk-theme, icon-theme and color-scheme are re-derived for the *new* theme by
# omarchy-theme-set-gnome before this hook runs; writing the saved values back
# would give e.g. amber-crt Miasma's icon theme. So XP sets gtk-theme (the
# scheme's B00merang GTK theme, named in the theme's gtk.theme) and
# color-scheme (XP is light, though its terminal palette makes colors.toml
# "dark") without restoring them; icon-theme comes from icons.theme.
GSETTINGS_SAVED=(gtk-theme icon-theme cursor-theme cursor-size font-name document-font-name monospace-font-name)
# XP pins no text size of its own. @PT@ is the point size of the font XP
# replaces, read from saved-state.json: Tahoma takes the pre-XP font-name's,
# Lucida Console the pre-XP monospace-font-name's (Omarchy's 11 if unreadable).
# Omarchy's text-scaling-factor stays Omarchy's and scales both, so XP GTK text
# is exactly as large as Omarchy's own would be.
declare -A GSETTINGS_XP=(
  [font-name]="'Tahoma @PT@'"
  [document-font-name]="'Tahoma @PT@'"
  [monospace-font-name]="'Lucida Console @PT@'"
  [cursor-theme]="'windows-xp-cursors'"
)
declare -A GSETTINGS_PT_FROM=([font-name]=font-name [document-font-name]=font-name [monospace-font-name]=monospace-font-name)

# saved_pt <key>: the pt at the end of the saved pre-XP value ('Adwaita Sans 11').
saved_pt() {
  local v
  v=$(jq -r --arg k "$1" '.gsettings[$k] // empty' "$SAVED" 2>/dev/null)
  v=${v%\'}
  v=${v##* }
  [[ $v =~ ^[0-9]+(\.[0-9]+)?$ ]] && echo "$v" || echo 11
}

# Hyprland draws the pointer itself (and for cursor-shape clients), so it is
# switched too. There is no getter for its theme, but with
# cursor:sync_gsettings_theme (default on) it mirrors whatever it loads into
# gsettings cursor-theme/-size, so the saved gsettings value is its pre-XP
# theme. 'default' is what it reports for "no theme set", and an empty theme
# reloads exactly that (XCURSOR_THEME or "default"), so it maps back to empty.
hypr_cursor() {
  local theme=${1#\'} size
  theme=${theme%\'}
  [[ $theme == default ]] && theme=
  size=$(gsettings get "$SCHEMA" cursor-size) || return 1
  [[ $(hyprctl setcursor "$theme" "$size") == ok ]] || { log "hyprctl setcursor '$theme' $size failed"; return 1; }
}

# Values are kept as gsettings' own GVariant text ('Adwaita Sans 11', 24), which
# `gsettings set` parses back exactly.
gsettings_save() {
  local k v args=()
  for k in "${GSETTINGS_SAVED[@]}"; do
    v=$(gsettings get "$SCHEMA" "$k") || return 1
    args+=(--arg "$k" "$v")
  done
  jq -n '$ARGS.named' "${args[@]}"
}

gsettings_apply() {
  local k v gtk="" rc=0
  for k in "${!GSETTINGS_XP[@]}"; do
    v=${GSETTINGS_XP[$k]}
    [[ -n ${GSETTINGS_PT_FROM[$k]:-} ]] && v=${v//@PT@/$(saved_pt "${GSETTINGS_PT_FROM[$k]}")}
    gsettings set "$SCHEMA" "$k" "$v" || { log "gsettings set $k $v failed"; rc=1; }
  done
  [[ -r $THEME_DIR/gtk.theme ]] && read -r gtk <"$THEME_DIR/gtk.theme"
  if [[ -n $gtk ]]; then
    gsettings set "$SCHEMA" gtk-theme "$gtk" || { log "gsettings set gtk-theme $gtk failed"; rc=1; }
  fi
  gsettings set "$SCHEMA" color-scheme prefer-light || { log "gsettings set color-scheme failed"; rc=1; }
  hypr_cursor "${GSETTINGS_XP[cursor-theme]}" || rc=1
  return $rc
}

gsettings_restore() {
  [[ $1 != null ]] || return 0
  local k v rc=0
  for k in "${!GSETTINGS_XP[@]}"; do
    v=$(jq -er --arg k "$k" '.[$k]' <<<"$1") || { log "no saved value for $k"; rc=1; continue; }
    gsettings set "$SCHEMA" "$k" "$v" || { log "gsettings set $k $v failed"; rc=1; }
  done
  hypr_cursor "$(jq -r '."cursor-theme"' <<<"$1")" || rc=1
  return $rc
}

# --------------------------------------------------------------------- hypr
# late.lua must load after hypr/looknfeel.lua: install it as a toggle (a copy;
# require_all skips symlinks). By the time the hook runs, omarchy-theme-set has
# already written theme.name and reloaded Hyprland, so reload again only when
# the installed copy actually changed.
hypr_save() { echo null; }

hypr_reload() {
  hyprctl reload >/dev/null || return 1
  local errs
  errs=$(hyprctl configerrors)
  [[ -z ${errs//[[:space:]]/} ]] || { log "hyprland config errors: $errs"; return 1; }
}

hypr_apply() {
  # Rebuild the caption-button hyprbars if a Hyprland update outdated it. In
  # the background, detached, and without our lock fd 9 (a build takes a
  # minute; theme switches must not wait on it).
  setsid -f "$XP_DIR/bin/xp-hyprbars-heal" </dev/null >/dev/null 2>&1 9>&-
  cmp -s "$LATE" "$TOGGLE" && return 0
  cp "$LATE" "$TOGGLE.tmp" && mv "$TOGGLE.tmp" "$TOGGLE" || return 1
  hypr_reload
}

# late.lua guards on theme.name, so after a theme switch the copy is already
# inert. Reload only when called directly while an XP theme is still active.
hypr_restore() {
  [[ -e $TOGGLE ]] || return 0
  rm -f "$TOGGLE" || return 1
  if xp_theme_active; then hypr_reload; fi
}

# -------------------------------------------------------------------- shell
# bar.id / plugins / disabledPlugins in shell.json. Absent is saved as null,
# present as {"v": value}, so restore can delete a key rather than write null
# into it. Restore writes only if the keys differ from what was saved, so a
# file XP never touched stays byte-identical (jq --indent 2 matches the
# shell's format).
SHELL_KEYS='{
  bar_id: (if (.bar | type) == "object" and (.bar | has("id")) then {v: .bar.id} else null end),
  disabledPlugins: (if has("disabledPlugins") then {v: .disabledPlugins} else null end),
  plugins: (if has("plugins") then {v: .plugins} else null end)
}'

shell_save() { jq -c "$SHELL_KEYS" "$SHELL_JSON"; }

# {"<plugin id>": "<omarchy.clonedFrom or null>"} for every installed plugin.
cloned_map() {
  local m=("$HOME"/.config/omarchy/plugins/*/manifest.json)
  [[ -e ${m[0]} ]] || { echo '{}'; return 0; }
  jq -cs 'map(select(type == "object" and (.id | type) == "string") | {(.id): (.omarchy.clonedFrom // null)}) | add // {}' "${m[@]}"
}

# XP selects the XP taskbar (omarchy/plugins/ocko.xp-taskbar) and swaps five
# first-party plugins for their XP clones, which exist only for this: a
# clone is enabled by its plugins[] entry, and the stock one it replaces
# goes in disabledPlugins[]. Callers keep using the omarchy.* ids; the
# shell's resolveEnabledId() routes them to the enabled clone. Non-XP
# themes never list the clones, so they load the stock plugins.
XP_BAR=ocko.xp-taskbar
XP_CLONES='[["ocko.xp-menu", "omarchy.menu"], ["ocko.xp-polkit", "omarchy.polkit"],
            ["ocko.xp-notifications", "omarchy.notifications"], ["ocko.xp-osd", "omarchy.osd"],
            ["ocko.xp-idle", "omarchy.idle"], ["ocko.xp-lock", "omarchy.lock"]]'
# Bar-widget clones are enabled the same way but the stock widget is NOT
# disabled: bar.layout keeps naming the stock id, the XP taskbar puts the
# enabled clone in its place (Bar.qml xpCloneEntry), and resolveEnabledId()
# sends `omarchy-shell shell toggle omarchy.<id>` to the clone. A stock bar
# (no XP) never sees them, because restore puts plugins[] back.
XP_WIDGET_CLONES='["ocko.xp-monitor", "ocko.xp-audio", "ocko.xp-network", "ocko.xp-clock", "ocko.xp-tray", "ocko.xp-power", "ocko.xp-weather", "ocko.xp-bluetooth", "ocko.xp-agents"]'
# Rivals: the user's own clones of the same stock plugin (manifest
# omarchy.clonedFrom, e.g. a you.polkit cloned from omarchy.polkit).
# One listed in plugins[] (or placed in bar.layout, which stock also counts as
# enabled: PluginRegistry.isEnabled -> findEntryLocation) would stay enabled
# next to the XP clone: two
# polkit agents or two lock services at once, and resolveEnabledId() would
# route omarchy.* calls to whichever it meets first. So every rival of an
# enabled XP clone goes in disabledPlugins[] as well (isDisabled() wins over
# plugins[]); plugins[] itself keeps its entries, and restore puts both keys
# back exactly. $cloned maps each installed plugin id to its clonedFrom.
# Order-preserving: entries already there keep their place; missing ones are appended.
# $failed (from compat_check) lists XP plugins the installed Omarchy broke:
# they are dropped from plugins[] (and their stock service comes back out of
# disabledPlugins[], unless it was disabled before XP, per $orig, the saved
# pre-XP keys). A failed taskbar keeps bar.id on the stock bar and drops the
# widget clones too, since only the XP taskbar places them.
# shellcheck disable=SC2016  # a jq program: its $vars are jq's, not the shell's
XP_CONFIG='($failed | index($bar) | not) as $bar_ok
  | ([(.plugins // [])[] | if type == "object" then .id else . end]
     + [(.bar.layout // {})[]? | arrays | .[] | if type == "object" then .id else . end]) as $listed
  | [$clones[] | select(.[0] as $c | $failed | index($c) | not)] as $on
  | [$clones[] | select(.[0] as $c | $failed | index($c))] as $off
  | (if $bar_ok then [$widgets[] | select(. as $c | $failed | index($c) | not)] else [] end) as $won
  | def rivals($pairs): [$pairs[] | .[0] as $c | .[1] as $s
      | select($s != null) | $cloned | to_entries[]
      | select(.value == $s and .key != $c and (.key as $k | $listed | index($k))) | .key];
    rivals($on + [$won[] | [., $cloned[.]]]) as $rivals
  | rivals($off + [($widgets - $won)[] | [., $cloned[.]]]) as $off_rivals
  | ([$off[] | .[0]] + ($widgets - $won)) as $drop
  | (([$off[] | .[1]] + $off_rivals) - ($orig.disabledPlugins.v // []) - $rivals) as $undisable
  | (if $bar_ok then .bar.id = $bar
     elif (.bar | type) == "object" and .bar.id == $bar then
       (if $orig.bar_id then .bar.id = $orig.bar_id.v else del(.bar.id) end)
     else . end)
  | .plugins = ([(.plugins // [])[] | select((if type == "object" then .id else . end) as $i | $drop | index($i) | not)] as $p
      | $p + [([$on[] | .[0]] + $won)[] as $c | select([$p[] | if type == "object" then .id else . end] | index($c) | not) | {id: $c}])
  | .disabledPlugins = ([(.disabledPlugins // [])[] | select(. as $s | $undisable | index($s) | not)] as $d
      | $d + ([$on[] | .[1]] + $rivals | reduce .[] as $s ([]; if index($s) then . else . + [$s] end)
              | map(select(. as $s | $d | index($s) | not))))'

# ------------------------------------------------------------ compatibility
# Every XP plugin copies stock Omarchy code and calls stock APIs, so an
# Omarchy update can break one. xp-compat-test prints "<id> ok|ok-unverified|
# fail <reason>" per plugin; the failing ones go in XP_FAILED (a JSON array)
# and stay off, so their stock plugin keeps working. If the test cannot run
# at all, every XP plugin stays off. The user is told once per distinct set
# of fallbacks (the marker), not on every theme switch.
XP_FAILED='[]'
COMPAT_NOTIFIED=$STATE_DIR/compat-fallback

compat_check() {
  local out rc ids=() id st name names=()
  out=$("$XP_DIR/bin/xp-compat-test" 2>&1)
  rc=$?
  if ((rc > 1)) || [[ -z $out ]]; then
    log "xp-compat-test could not run (exit $rc): $out -- every XP plugin stays off"
    for id in "$XP_DIR"/../plugins/ocko.xp-*/; do id=${id%/}; ids+=("${id##*/}"); done
  else
    while read -r id st _; do [[ $st == fail ]] && ids+=("$id"); done <<<"$out"
    ((${#ids[@]})) && log "xp-compat-test: $(grep -v ' ok$' <<<"$out" | tr '\n' ';')"
  fi
  # A clone that is not installed at all counts as failed: enabling it would
  # disable the stock plugin (and the user's own clones of it) for nothing,
  # which for the lock would mean no lock screen.
  for id in "$XP_BAR" $(jq -r '.[][0]' <<<"$XP_CLONES") $(jq -r '.[]' <<<"$XP_WIDGET_CLONES"); do
    [[ -r $XP_DIR/../plugins/$id/manifest.json ]] && continue
    [[ " ${ids[*]} " == *" $id "* ]] || { ids+=("$id"); log "$id is not installed; its stock plugin stays in use"; }
  done
  XP_FAILED=$(printf '%s\n' "${ids[@]}" | jq -R . | jq -cs 'map(select(length > 0))')
  if ((${#ids[@]} == 0)); then
    rm -f "$COMPAT_NOTIFIED"
    return 0
  fi
  [[ -r $COMPAT_NOTIFIED && $(<"$COMPAT_NOTIFIED") == "$XP_FAILED" ]] && return 0
  echo "$XP_FAILED" >"$COMPAT_NOTIFIED"
  for id in "${ids[@]}"; do
    name=$(jq -r '.name // empty' "$XP_DIR/../plugins/$id/manifest.json" 2>/dev/null)
    names+=("${name:-$id}")
  done
  omarchy-notification-send -u normal "Windows XP: some parts fell back to Omarchy's own" \
    "This Omarchy version changed what they need, so the stock versions are in use: $(printf '%s, ' "${names[@]}" | sed 's/, $//'). Details: ~/.local/state/omarchy/xp/xp-mode.log" \
    >/dev/null 2>&1 || log "could not send the fallback notification"
}

# The swap needs a shell restart. omarchy.notifications and omarchy.polkit
# own session-wide names (org.freedesktop.Notifications, the polkit agent
# object), and the shell creates a newly enabled service before it destroys
# the one being disabled, so a live swap leaves the clone without the name
# (verified 2026-10-28, see evidence/phaseC/task8/NOTES.md). A restart also
# covers the two omarchy 4.0.6 bar-swap bugs (CLAUDE.md). Never restart
# while the session is locked: then only the bar is selected live, the
# Phase B way (enable + rescan), and the clones wait for the next unlocked
# `xp-mode on`.
shell_apply() {
  local locked orig=null cloned
  compat_check
  [[ -r $SAVED ]] && orig=$(jq -c '.shell // null' "$SAVED")
  cloned=$(cloned_map) || return 1
  # The XP taskbar reads this to place its widget clones over bar.layout
  # entries that name the user's own clones (you.power cloned from
  # omarchy.power -> ocko.xp-power): a plugin bar cannot see other manifests.
  [[ $(cat "$STATE_DIR/clones.json" 2>/dev/null) == "$cloned" ]] ||
    { printf '%s\n' "$cloned" >"$STATE_DIR/clones.json.tmp" && mv "$STATE_DIR/clones.json.tmp" "$STATE_DIR/clones.json"; }
  jq --indent 2 --arg bar "$XP_BAR" --argjson clones "$XP_CLONES" --argjson widgets "$XP_WIDGET_CLONES" \
    --argjson failed "$XP_FAILED" --argjson orig "$orig" --argjson cloned "$cloned" \
    "$XP_CONFIG" "$SHELL_JSON" >"$SHELL_JSON.xp-tmp" || return 1
  # Quoted right-hand side: unquoted, [[ == ]] reads it as a glob pattern and
  # JSON's brackets never match (it restarted the shell on every XP -> XP switch).
  if [[ $(jq -cS . "$SHELL_JSON.xp-tmp") == "$(jq -cS . "$SHELL_JSON")" ]]; then
    rm -f "$SHELL_JSON.xp-tmp"
    return 0
  fi
  locked=$(timeout 3 omarchy-shell lock isLocked 2>/dev/null)
  if [[ $locked == true ]]; then
    rm -f "$SHELL_JSON.xp-tmp"
    log "session locked: selecting the XP bar live only; the XP menu/polkit/notification/OSD/idle clones load at the next unlocked 'omarchy theme set windows-xp*'"
    [[ $(jq -r '.bar.id // empty' "$SHELL_JSON") == "$XP_BAR" ]] && return 0
    jq -e --arg bar "$XP_BAR" 'index($bar)' <<<"$XP_FAILED" >/dev/null && return 0
    timeout 5 omarchy-plugin-enable "$XP_BAR" >/dev/null || return 1
    timeout 5 omarchy-shell shell rescanPlugins >/dev/null || log "rescanPlugins failed; XP tray may be blank until omarchy-restart-shell"
    return 0
  fi
  log "selecting the XP bar and plugins in shell.json (diff: $(diff <(jq -S . "$SHELL_JSON") <(jq -S . "$SHELL_JSON.xp-tmp") | grep -c "^[<>]") lines)"
  mv "$SHELL_JSON.xp-tmp" "$SHELL_JSON" || return 1
  if [[ $locked == false ]]; then
    shell_restart
  else
    log "shell not answering: XP config written to shell.json; it applies when the shell starts"
  fi
}

shell_restore() {
  [[ $1 != null ]] || return 0
  local now
  now=$(jq -c "$SHELL_KEYS" "$SHELL_JSON") || return 1
  [[ $(jq -cS . <<<"$now") == "$(jq -cS . <<<"$1")" ]] && return 0
  # A saved state from before `plugins` was recorded leaves plugins alone.
  jq --indent 2 --argjson s "$1" '
    (if $s.bar_id then .bar.id = $s.bar_id.v elif (.bar | type) == "object" then del(.bar.id) else . end)
    | (if $s.disabledPlugins then .disabledPlugins = $s.disabledPlugins.v else del(.disabledPlugins) end)
    | (if ($s | has("plugins")) then (if $s.plugins then .plugins = $s.plugins.v else del(.plugins) end) else . end)
  ' "$SHELL_JSON" >"$SHELL_JSON.xp-tmp" && mv "$SHELL_JSON.xp-tmp" "$SHELL_JSON" || return 1
  shell_restart
  return 0
}

# Both directions restart the shell: entering XP for the service swap (see
# shell_apply); leaving it for the swap back and because omarchy 4.0.6
# leaves the shell's `bar` reference null after a live switch from a plugin
# bar to the built-in one (shell.qml: the default bar's Loader configures
# it, then the plugin bar Loader's onActiveChanged clears it), which breaks
# `omarchy-shell shell toggle <panel>` hotkeys and the notification offset.
# Never while the session is locked.
#
# omarchy-restart-shell is not serialised: two overlapping calls both kill
# every instance, both see none left, and both launch one, so the session
# ends with two shells (two bars, two lock services, two polkit agents).
# Another theme's own hook can restart the shell at the same moment (one that
# switches its icon font does), so ours runs under a lock and a detached check
# watches for 30 s afterwards: two shells seen twice in a row, while
# unlocked, get one more (locked) restart, which leaves one.
SHELL_RESTART_LOCK=${XDG_RUNTIME_DIR:-/tmp}/omarchy-shell-restart.lock

shell_restart() {
  if [[ $(timeout 3 omarchy-shell lock isLocked 2>/dev/null) == false ]]; then
    flock "$SHELL_RESTART_LOCK" omarchy-restart-shell >/dev/null 2>&1 ||
      log "omarchy-restart-shell failed; run it by hand to load the right plugins"
    # shellcheck disable=SC2016  # the script expands in the child bash
    setsid -f bash -c '
      count() { quickshell list -a -j 2>/dev/null | jq --arg d "$1" "[.[] | select(.config_path | startswith(\$d))] | length"; }
      seen=0
      for _ in $(seq 15); do
        sleep 2
        n=$(count "$1")
        if ((${n:-0} > 1)); then seen=$((seen + 1)); else seen=0; fi
        ((seen < 2)) && continue
        [[ $(timeout 3 omarchy-shell lock isLocked 2>/dev/null) == false ]] || exit 0
        printf "%(%F %T)T xp-mode: two Omarchy shells after overlapping restarts; restarting once\n" -1 >>"$2"
        exec flock "$3" omarchy-restart-shell
      done' _ "${OMARCHY_PATH:-/usr/share/omarchy}/shell/" "$LOG" "$SHELL_RESTART_LOCK" </dev/null >/dev/null 2>&1 9>&-
  else
    log "session locked or shell not answering: skipped shell restart; run omarchy-restart-shell"
  fi
}

# --------------------------------------------------------------------- tmux
# tmux/tmux.conf sources the active theme's tmux.conf last, so a server started
# later picks the XP status bar up, or drops it, by itself. One that is already
# running has to be pushed: `on` sources the theme's file; `off` re-sources
# tmux.conf, which sets every option the XP file overrides (and, the theme
# having changed, no longer finds an XP file to source). Default socket only.
TMUX_THEME=$HOME/.local/state/omarchy/current/theme/tmux.conf

tmux_save() { echo null; }

tmux_apply() {
  tmux has-session 2>/dev/null || return 0
  [[ -r $TMUX_THEME ]] || { log "theme has no $TMUX_THEME"; return 1; }
  tmux source-file "$TMUX_THEME"
}

tmux_restore() {
  tmux has-session 2>/dev/null || return 0
  tmux source-file "$HOME/.config/tmux/tmux.conf"
}

# -------------------------------------------------------------------- files
# Files XP swaps in place. On the first `on`, each pre-XP file is moved (mv,
# so bytes, inode and mtime survive) into $ORIG, or an .absent marker is left
# if there was none; `off` moves it back or deletes what XP put there. Later
# `on`s only refresh the XP side, so an XP -> XP switch never stashes XP's own
# files as "original". Kinds: none (absent under XP), copy <src>, link <target>.
#   gtk-3.0/gtk.css   ocko's Aether override would recolour the GTK3 XP theme
#   gtk-4.0/gtk.css   -> the scheme's libadwaita palette (theme gtk.css)
#   Zen userChrome    -> scheme zen.css (+ zen-dark.css with browser-dark on)
#                     + omarchy/xp/zen/userChrome.css
#   branding, fastfetch: the XP About logo (fastfetch's config inlines its own
#                     logo and never reads about.txt, so it is swapped too)
ORIG=$STATE_DIR/orig
ZEN_CSS=$STATE_DIR/zen-userChrome.css

# The live Zen profile is the install's locked Default=, not profiles.ini's.
zen_profile() {
  local line
  [[ -r $HOME/.config/zen/installs.ini ]] || return 1
  while IFS= read -r line; do
    [[ $line == Default=* ]] && { echo "$HOME/.config/zen/${line#Default=}"; return 0; }
  done <"$HOME/.config/zen/installs.ini"
  return 1
}

files_list() {
  local zp
  printf '%s\n' "$HOME/.config/gtk-3.0/gtk.css|none" \
    "$HOME/.config/gtk-4.0/gtk.css|link|$THEME_DIR/gtk.css" \
    "$HOME/.config/omarchy/branding/about.txt|copy|$XP_DIR/assets/branding/about.txt" \
    "$HOME/.config/omarchy/branding/screensaver.txt|copy|$XP_DIR/assets/branding/screensaver.txt" \
    "$HOME/.config/fastfetch/config.jsonc|copy|$XP_DIR/fastfetch.jsonc"
  if zp=$(zen_profile) && [[ -d $zp/chrome ]]; then
    echo "$zp/chrome/userChrome.css|link|$ZEN_CSS"
  else
    log "no live Zen profile with a chrome/ dir; Zen stays unstyled"
  fi
}

files_save() { echo null; }

zen_css_build() {
  local dark=()
  browser_dark_wanted && [[ -r $THEME_DIR/zen-dark.css ]] && dark=("$THEME_DIR/zen-dark.css")
  cat "$THEME_DIR/zen.css" "${dark[@]}" "$XP_DIR/zen/userChrome.css" >"$ZEN_CSS.tmp" && mv "$ZEN_CSS.tmp" "$ZEN_CSS"
}

files_apply() {
  local path kind src aside rc=0
  mkdir -p "$ORIG" || return 1
  zen_css_build || rc=1
  while IFS='|' read -r path kind src; do
    aside=$ORIG/${path//\//%}
    if [[ ! -e $aside && ! -L $aside && ! -e $aside.absent ]]; then
      if [[ -e $path || -L $path ]]; then
        mv -T "$path" "$aside" || { log "could not stash $path"; rc=1; continue; }
      else
        : >"$aside.absent" || { rc=1; continue; }
      fi
    fi
    # A parent directory XP has to create (gtk-4.0/ on a system that never
    # had one) is recorded in the .absent marker, so `off` removes it again.
    # Also covers a marker left empty by an earlier version that never
    # created the directory.
    if [[ -e $aside.absent && ! -s $aside.absent && ! -d ${path%/*} ]]; then
      local d=${path%/*} created=""
      while [[ $d == /?* && ! -d $d ]]; do created=$d; d=${d%/*}; done
      printf '%s\n' "$created" >"$aside.absent" || { rc=1; continue; }
    fi
    [[ $kind == none ]] || mkdir -p "${path%/*}" || { log "could not create ${path%/*}"; rc=1; continue; }
    case $kind in
      none) rm -f "$path" ;;
      copy) rm -f "$path" && cp "$src" "$path" ;;
      link) ln -sfn "$src" "$path" ;;
    esac || { log "could not install the XP $path"; rc=1; }
  done < <(files_list)
  return $rc
}

# Walks $ORIG rather than files_list, so a file stashed under an earlier
# layout (or a Zen profile that has since changed) still comes back.
files_restore() {
  local aside path rc=0
  [[ -d $ORIG ]] || return 0
  for aside in "$ORIG"/*; do
    [[ -e $aside || -L $aside ]] || continue
    path=${aside#"$ORIG"/}
    if [[ $path == *.absent ]]; then
      path=${path%.absent}
      path=${path//%//}
      local created="" d
      read -r created <"$aside"
      rm -f "$path" || { log "could not remove the XP $path"; rc=1; continue; }
      # Remove the directories XP created, innermost first, only while empty
      # (anything put there since is left alone, with its directory).
      if [[ -n $created ]]; then
        d=${path%/*}
        while [[ $d == "$created" || $d == "$created"/* ]]; do
          rmdir "$d" 2>/dev/null || break
          d=${d%/*}
        done
      fi
      rm -f "$aside" || { log "could not remove $aside"; rc=1; }
    else
      path=${path//%//}
      if ! { rm -f "$path" && mv -T "$aside" "$path"; }; then log "could not restore $path"; rc=1; fi
    fi
  done
  ((rc == 0)) && rm -f "$ZEN_CSS" && rmdir "$ORIG"
  return $rc
}

# -------------------------------------------------------------------- sizes
# The XP terminal font follows Omarchy's text size. `omarchy display text
# size` writes the terminal pt into ~/.config/foot/foot.ini (Omarchy's default
# is 9); Lucida Console needs pt x 13/12 to match JetBrainsMono's x-height
# there (9 -> 10, the desktop's 12 -> 13). Only the size fields of the font=
# line in the live copy of the theme's foot.ini change, via a new file, so
# nothing tracked is written; theme-set regenerates the copy from the theme.
# The shell and GTK follow Omarchy by themselves (no base-size pin in the XP
# shell.toml; gsettings_apply above). Nothing to restore: a theme switch
# replaces the live copy.
USER_FOOT=$HOME/.config/foot/foot.ini

sizes_save() { echo null; }
sizes_restore() { return 0; }

sizes_apply() {
  local pt=9 lpt line live=$THEME_DIR/foot.ini
  if [[ -r $USER_FOOT ]]; then
    while IFS= read -r line; do
      [[ $line =~ ^[[:space:]]*font[[:space:]]*=.*:size=([0-9.]+) ]] && { pt=${BASH_REMATCH[1]}; break; }
    done <"$USER_FOOT"
  fi
  lpt=$(awk -v p="$pt" 'BEGIN { printf "%d", int(p * 13 / 12 + 0.5) }')
  [[ -r $live ]] || { log "no $live to size"; return 1; }
  sed -E "/^[[:space:]]*font[[:space:]]*=/ s/(:size=)[0-9.]+/\1$lpt/g" "$live" >"$live.xp-tmp" || return 1
  if cmp -s "$live.xp-tmp" "$live"; then
    rm -f "$live.xp-tmp"
  else
    mv "$live.xp-tmp" "$live" && log "terminal: foot $pt pt -> Lucida Console $lpt pt"
  fi
}

# ---------------------------------------------------------- browser (dark)
# Dark mode for Zen, Chromium and Chrome: dark pages (prefers-color-scheme)
# and dark browser UI that keeps the XP look. On unless the user's setting
# ($BROWSER_DARK, `xp-mode browser-dark off`) says off; it survives theme
# switches and reboots. GTK stays prefer-light (gsettings step), so nothing
# here can follow the desktop; each browser is set directly. Everything takes
# effect at the browser's next start, except the Chromium seed colour, which
# a running Chromium/Chrome picks up as Omarchy's own theme switch does.
#   Chromium, Chrome  --force-dark-mode in a marked block at the end of
#                     chromium-flags.conf / chrome-flags.conf (only files that
#                     exist; a byte-exact copy of each waits in $BD_DIR), and
#                     the scheme's chromium-dark.theme as BrowserThemeColor
#                     through Omarchy's passwordless policy helper (the light
#                     seed stays vivid on a dark UI). BrowserColorScheme stays
#                     Omarchy's "device"; the flag wins over it.
#   Zen               a marked user.js block: whenever XP is on, $ZEN_CSS_PREF
#                     (Zen loads no chrome/userChrome.css without it, so the
#                     files step's XP look needs it, light or dark); with dark
#                     mode, content-override 0 (dark pages) and Zen's own
#                     zen.view.window.scheme 0 (its default 2 follows GTK,
#                     which stays light), plus zen-dark.css in the userChrome
#                     (files step). The block keeps its browser-dark marker.
# A pref user.js once set stays in prefs.js after the line goes, and a running
# Zen rewrites prefs.js from memory on exit. So dropping a pref with Zen
# closed takes its line out of the block and puts the saved pre-XP prefs.js
# line back (or none); with Zen running, the block instead resets the pref
# (the saved value, or Zen's default, which clears it on Zen's next start)
# and $ZEN_PENDING has the next xp-mode call or login (post-boot.d) finish
# the job once Zen is closed. Nothing watches or polls.
BROWSER_DARK=$XP_DIR/browser-dark
BD_DIR=$STATE_DIR/browser-dark
ZEN_PENDING=$STATE_DIR/zen-pending
# Vista's: on XP -> Vista -> XP, a reset block Vista left pending holds the
# real pre-theme value.
OTHER_PENDING=$HOME/.local/state/omarchy/vista/zen-pending
BD_BEGIN='# >>> omarchy-windows-xp browser-dark'
BD_END='# <<< omarchy-windows-xp browser-dark'
ZEN_BEGIN='// >>> omarchy-windows-xp browser-dark'
ZEN_END='// <<< omarchy-windows-xp browser-dark'
ZEN_CSS_PREF=toolkit.legacyUserProfileCustomizations.stylesheets
ZEN_PAGES_PREF=layout.css.prefers-color-scheme.content-override
ZEN_SCHEME_PREF=zen.view.window.scheme
# Every pref the block can hold, with Zen's default (the reset value).
declare -A ZEN_DEFAULT=([$ZEN_CSS_PREF]=false [$ZEN_PAGES_PREF]=2 [$ZEN_SCHEME_PREF]=2)
ZEN_PREFS=("$ZEN_CSS_PREF" "$ZEN_PAGES_PREF" "$ZEN_SCHEME_PREF")
FLAGS_FILES=("${XDG_CONFIG_HOME:-$HOME/.config}/chromium-flags.conf" "${XDG_CONFIG_HOME:-$HOME/.config}/chrome-flags.conf")

browser_dark_wanted() { [[ $(cat "$BROWSER_DARK" 2>/dev/null) != off ]]; }

# strip_marked <file> <begin> <end>: the file without the block and the one
# blank line put above it (below it, for a block at the top).
strip_marked() {
  B=$2 E=$3 awk '
    { line[NR] = $0 }
    END {
      for (i = 1; i <= NR; i++) if (line[i] == ENVIRON["B"]) { s = i; break }
      if (!s) { for (i = 1; i <= NR; i++) print line[i]; exit }
      for (t = s; t <= NR && line[t] != ENVIRON["E"]; t++);
      if (s > 1 && line[s - 1] == "") s--
      else if (s == 1 && t < NR && line[t + 1] == "") t++
      for (i = 1; i <= NR; i++) if (i < s || i > t) print line[i]
    }' "$1"
}

flags_block() {
  printf '%s\n%s\n%s\n%s\n' "$BD_BEGIN" \
    "# Windows XP browser dark mode (xp-mode browser-dark on|off)." --force-dark-mode "$BD_END"
}

# flags_tail <original>: what flags_add appends to it.
flags_tail() {
  [[ -s $1 ]] && { [[ -n $(tail -c1 "$1") ]] && printf '\n'; printf '\n'; }
  flags_block
}

flags_add() {
  local f=$1 keep=$BD_DIR/${1##*/}
  [[ -f $f ]] || return 0
  grep -qxF "$BD_BEGIN" "$f" && return 0
  mkdir -p "$BD_DIR" && cp -a "$f" "$keep" || return 1
  flags_tail "$keep" >>"$f"
}

# Back byte for byte (and with its mtime) from the copy when the file is
# still exactly what flags_add left; otherwise (edited since) only the block
# goes, and the copy stays if the result differs from it.
flags_remove() {
  local f=$1 keep=$BD_DIR/${1##*/}
  if [[ ! -f $f ]] || ! grep -qxF "$BD_BEGIN" "$f"; then
    rm -f "$keep"
    return 0
  fi
  if [[ -f $keep ]] && cmp -s "$f" <(cat "$keep"; flags_tail "$keep"); then
    mv -f "$keep" "$f"
    return
  fi
  strip_marked "$f" "$BD_BEGIN" "$BD_END" >"$f.xp-tmp" && cat "$f.xp-tmp" >"$f" && rm -f "$f.xp-tmp" || return 1
  if [[ ! -f $keep ]] || cmp -s "$f" "$keep"; then
    rm -f "$keep"
  else
    log "$f changed while dark mode was on: removed the dark-mode block, kept the pre-dark copy in $keep"
  fi
}

# rrggbb from a theme's "r,g,b" file (the format omarchy-theme-set-browser reads).
seed_hex() {
  local rgb
  [[ -r $1 ]] && rgb=$(<"$1") || return 1
  [[ $rgb =~ ^[[:space:]]*([0-9]{1,3})[[:space:]]*,[[:space:]]*([0-9]{1,3})[[:space:]]*,[[:space:]]*([0-9]{1,3})[[:space:]]*$ ]] || return 1
  ((10#${BASH_REMATCH[1]} < 256 && 10#${BASH_REMATCH[2]} < 256 && 10#${BASH_REMATCH[3]} < 256)) || return 1
  printf '%02x%02x%02x' "$((10#${BASH_REMATCH[1]}))" "$((10#${BASH_REMATCH[2]}))" "$((10#${BASH_REMATCH[3]}))"
}

# What omarchy-theme-set-browser does after writing the policy.
browser_refresh() {
  local proc cmd
  while read -r proc cmd; do
    command -v "$cmd" >/dev/null && pgrep -x "$proc" >/dev/null &&
      "$cmd" --refresh-platform-policy --no-startup-window &>/dev/null
  done <<'EOF'
chromium chromium
chrome google-chrome-stable
EOF
  return 0
}

policy_dark() {
  local hex
  hex=$(seed_hex "$THEME_DIR/chromium-dark.theme") || { log "theme has no valid chromium-dark.theme; Chromium keeps the light seed"; return 0; }
  omarchy-theme-set-browser-policy "$hex" || { log "omarchy-theme-set-browser-policy $hex failed"; return 1; }
  browser_refresh
}

# Omarchy's own value for the current theme (its chromium.theme seed).
policy_light() {
  omarchy-theme-set-browser >/dev/null 2>&1 || { log "omarchy-theme-set-browser failed"; return 1; }
}

# The live profile's lock names the pid of the Zen that holds it.
zen_running() {
  local t
  t=$(readlink "$1/lock" 2>/dev/null) || return 1
  t=${t##*+}
  [[ $t =~ ^[0-9]+$ && -d /proc/$t ]]
}

# zen_record <json>: the saved record with .prefs as {pref: the pre-XP
# prefs.js line or null}. A record from before the stylesheets and scheme
# prefs holds only the content-override line (or null) as .prefs.
zen_record() {
  jq -c --arg k "$ZEN_PAGES_PREF" \
    '{profile, prefs: (if (.prefs | type) == "object" then .prefs else {($k): .prefs} end), userjs}' <<<"$1"
}

# zen_wanted: the "pref value" lines of the block while XP is on.
zen_wanted() {
  echo "$ZEN_CSS_PREF true"
  browser_dark_wanted && printf '%s 0\n' "$ZEN_PAGES_PREF" "$ZEN_SCHEME_PREF"
  return 0
}

# userjs_set <profile> <lines>: our block holding <lines>, replacing the one
# there or appended (after one blank line).
userjs_set() {
  local u=$1/user.js blk
  blk=$(printf '%s\n%s%s' "$ZEN_BEGIN" "$2" "$ZEN_END")
  if [[ -f $u ]] && grep -qxF "$ZEN_BEGIN" "$u"; then
    B=$ZEN_BEGIN E=$ZEN_END BLK=$blk awk '
      $0 == ENVIRON["B"] { print ENVIRON["BLK"]; skip = 1; next }
      skip { if ($0 == ENVIRON["E"]) skip = 0; next }
      { print }' "$u" >"$u.xp-tmp" || return 1
    cmp -s "$u.xp-tmp" "$u" || cat "$u.xp-tmp" >"$u"
    rm -f "$u.xp-tmp"
  elif [[ -s $u ]]; then
    local sep=$'\n'
    [[ -n $(tail -c1 "$u") ]] && sep=$'\n\n'
    printf '%s%s\n' "$sep" "$blk" >>"$u"
  else
    echo "$blk" >>"$u"
  fi
}

# zen_sync <saved> [<pref value>...]: make our block hold exactly these prefs
# (none: no block); <saved> is the browser step's record ({profile, prefs:
# {pref: the pre-XP prefs.js line or null}, userjs: user.js existed}). A pref
# the block holds now and should not keeps a reset line while Zen runs.
zen_sync() {
  local rec zp u p v line old="" body="" reset=0
  local -A want=()
  rec=$(zen_record "$1") || return 1
  shift
  for p; do want[${p%% *}]=${p#* }; done
  zp=$(jq -r '.profile // empty' <<<"$rec")
  [[ -n $zp && -d $zp ]] || { rm -f "$ZEN_PENDING"; return 0; }
  u=$zp/user.js
  [[ -f $u ]] && old=$(B=$ZEN_BEGIN E=$ZEN_END awk '$0 == ENVIRON["B"] { on = 1; next } $0 == ENVIRON["E"] { on = 0 } on' "$u")
  local running=0
  zen_running "$zp" && running=1
  for p in "${ZEN_PREFS[@]}"; do
    if [[ -v want[$p] ]]; then
      body+="user_pref(\"$p\", ${want[$p]});"$'\n'
    elif ((running)) && [[ $old == *"user_pref(\"$p\","* ]]; then
      line=$(jq -r --arg p "$p" '.prefs[$p] // empty' <<<"$rec")
      v=${ZEN_DEFAULT[$p]}
      [[ $line =~ ,[[:space:]]*(.+)\)\;$ ]] && v=${BASH_REMATCH[1]}
      body+="user_pref(\"$p\", $v);"$'\n'
      reset=1
    fi
  done
  if [[ -n $body ]]; then
    userjs_set "$zp" "$body" || return 1
  elif [[ -f $u ]] && grep -qxF "$ZEN_BEGIN" "$u"; then
    strip_marked "$u" "$ZEN_BEGIN" "$ZEN_END" >"$u.xp-tmp" || return 1
    if [[ ! -s $u.xp-tmp && $(jq -r '.userjs' <<<"$rec") == false ]]; then
      rm -f "$u" "$u.xp-tmp"
    else
      cat "$u.xp-tmp" >"$u" && rm -f "$u.xp-tmp"
    fi
  fi
  if ((reset)); then
    [[ -e $ZEN_PENDING ]] || log "Zen is running: its old prefs come back at its next start; the user.js clean-up finishes once it is closed"
    echo "$rec" >"$ZEN_PENDING"
    return 0
  fi
  if ((!running)); then
    for p in "${ZEN_PREFS[@]}"; do
      [[ -v want[$p] || $old != *"user_pref(\"$p\","* ]] && continue
      prefs_restore "$zp/prefs.js" "$p" "$(jq -r --arg p "$p" '.prefs[$p] // empty' <<<"$rec")" || return 1
    done
  fi
  rm -f "$ZEN_PENDING"
}

# prefs_restore <prefs.js> <pref> <line>: the pref's line out, the saved one
# (if any) back in at its sorted place, as Zen writes them. Untouched if equal.
prefs_restore() {
  [[ -f $1 ]] || return 0
  K="user_pref(\"$2\"," L=$3 awk '
    BEGIN { done = (ENVIRON["L"] == "") }
    index($0, ENVIRON["K"]) == 1 { next }
    !done && /^user_pref\(/ && $0 > ENVIRON["L"] { print ENVIRON["L"]; done = 1 }
    { print }
    END { if (!done) print ENVIRON["L"] }' "$1" >"$1.xp-tmp" || return 1
  cmp -s "$1.xp-tmp" "$1" || cat "$1.xp-tmp" >"$1"
  rm -f "$1.xp-tmp"
}

# A clean-up left pending: the block XP wants now (none once XP is off).
zen_finish_pending() {
  local want=()
  [[ -r $ZEN_PENDING ]] || return 0
  [[ -e $SAVED ]] && xp_theme_active && mapfile -t want < <(zen_wanted)
  zen_sync "$(<"$ZEN_PENDING")" "${want[@]}"
}

# A pending record (ours or Vista's) for this profile holds the true
# pre-theme values: prefs.js may still carry XP's.
browser_save() {
  local zp pf p line prefs='{}'
  zp=$(zen_profile) || { echo null; return 0; }
  for pf in "$ZEN_PENDING" "$OTHER_PENDING"; do
    [[ -r $pf && $(jq -r '.profile' "$pf" 2>/dev/null) == "$zp" ]] && { zen_record "$(<"$pf")"; return; }
  done
  for p in "${ZEN_PREFS[@]}"; do
    line=$(grep -m1 -F "user_pref(\"$p\"," "$zp/prefs.js" 2>/dev/null)
    prefs=$(jq -c --arg p "$p" --arg l "$line" '. + {($p): (if $l == "" then null else $l end)}' <<<"$prefs")
  done
  jq -cn --arg p "$zp" --argjson prefs "$prefs" --argjson u "$([[ -e $zp/user.js ]] && echo true || echo false)" \
    '{profile: $p, prefs: $prefs, userjs: $u}'
}

# The saved record. A saved state from before this step has none: then a
# pending record for the live profile (ours or the other theme's), else one
# that assumes no pre-XP values and keeps user.js.
browser_saved() {
  local b=null zp pf
  [[ -r $SAVED ]] && b=$(jq -c '.browser // null' "$SAVED")
  if [[ $b == null ]] && zp=$(zen_profile); then
    for pf in "$ZEN_PENDING" "$OTHER_PENDING"; do
      [[ -r $pf && $(jq -r '.profile' "$pf" 2>/dev/null) == "$zp" ]] && { zen_record "$(<"$pf")"; return; }
    done
    b=$(jq -cn --arg p "$zp" '{profile: $p, prefs: {}, userjs: true}')
  fi
  [[ $b == null ]] && { echo null; return; }
  zen_record "$b"
}

# browser_undark <saved> [<pref value>...]: no dark flags; Zen's block holds
# only the given prefs.
browser_undark() {
  local f s=$1 rc=0
  shift
  for f in "${FLAGS_FILES[@]}"; do flags_remove "$f" || { log "could not remove the dark-mode block from $f"; rc=1; }; done
  zen_sync "$s" "$@" || { log "could not update Zen's user.js"; rc=1; }
  return $rc
}

browser_apply() {
  local f rc=0 saved want=()
  saved=$(browser_saved)
  mapfile -t want < <(zen_wanted)
  if ! browser_dark_wanted; then
    browser_undark "$saved" "${want[@]}"
    return
  fi
  for f in "${FLAGS_FILES[@]}"; do flags_add "$f" || { log "could not add the dark-mode flag to $f"; rc=1; }; done
  policy_dark || rc=1
  zen_sync "$saved" "${want[@]}" || { log "could not write Zen's user.js"; rc=1; }
  return $rc
}

# Leaving XP: omarchy-theme-set has already written the new theme's seed.
browser_restore() {
  [[ $1 != null ]] || set -- "$(browser_saved)"
  [[ $1 != null ]] || set -- '{}'
  browser_undark "$1"
}

browser_status() {
  local f state zp u
  if browser_dark_wanted; then state=on; else state=off; fi
  echo "browser-dark: $state ($([[ -e $BROWSER_DARK ]] && echo "set in $BROWSER_DARK" || echo 'default'))"
  for f in "${FLAGS_FILES[@]}"; do
    if [[ ! -f $f ]]; then echo "  ${f/#$HOME/\~}: absent"
    elif grep -qxF "$BD_BEGIN" "$f"; then echo "  ${f/#$HOME/\~}: --force-dark-mode block"
    else echo "  ${f/#$HOME/\~}: no block"; fi
  done
  f=$(jq -r '.BrowserThemeColor // empty' /etc/chromium/policies/managed/color.json 2>/dev/null)
  echo "  Chromium seed (policy): ${f:-unknown}"
  if zp=$(zen_profile); then
    u=$zp/user.js
    if [[ -f $u ]] && grep -qxF "$ZEN_BEGIN" "$u"; then
      echo "  Zen user.js block:"
      B=$ZEN_BEGIN E=$ZEN_END awk '$0 == ENVIRON["B"] { on = 1; next } $0 == ENVIRON["E"] { on = 0 } on { print "    " $0 }' "$u"
    else
      echo "  Zen user.js: no block"
    fi
    if [[ -e $ZEN_PENDING ]]; then echo "  Zen: reset pending, finished once Zen is closed"; fi
    if [[ -r $ZEN_CSS ]] && grep -q 'browser-dark: the dark half' "$ZEN_CSS"; then echo "  Zen userChrome: dark"
    elif [[ -r $ZEN_CSS ]]; then echo "  Zen userChrome: light"; fi
  fi
}

cmd_browser_dark() {
  local running=() p
  echo "$1" >"$BROWSER_DARK.tmp" && mv "$BROWSER_DARK.tmp" "$BROWSER_DARK" || return 1
  if [[ ! -e $SAVED ]] || ! xp_theme_active; then
    echo "Browser dark mode $1: applies the next time a Windows XP theme is set."
    return 0
  fi
  local rc=0
  zen_css_build || rc=1
  browser_apply || rc=1
  if [[ $1 == off ]]; then policy_light || rc=1; fi
  for p in zen-bin:Zen chromium:Chromium chrome:Chrome; do pgrep -x "${p%%:*}" >/dev/null && running+=("${p#*:}"); done
  if ((${#running[@]})); then
    echo "Browser dark mode $1. Restart $(printf '%s, ' "${running[@]}" | sed 's/, $//') to apply."
  else
    echo "Browser dark mode $1: applies when the browsers start."
  fi
  return $rc
}

# ---------------------------------------------------------------- commands
save_state() {
  local s v args=()
  for s in "${STEPS[@]}"; do
    v=$("${s}_save") || { log "save failed in step $s"; return 1; }
    args+=(--argjson "$s" "$v")
  done
  jq -n '$ARGS.named' "${args[@]}" >"$SAVED.tmp" && mv "$SAVED.tmp" "$SAVED"
}

# Windows Vista (the omarchy-windows-vista package) may be installed too. Its
# theme-set hooks already run its `off` before this `on` (00-windows-vista-off),
# but a direct `xp-mode on` must not save Vista's state as "pre-XP".
VISTA_MODE=$HOME/.config/omarchy/vista/bin/vista-mode

cmd_on() {
  mkdir -p "$STATE_DIR" || return 1
  if [[ -x $VISTA_MODE ]] && [[ $("$VISTA_MODE" status 2>/dev/null | head -n 1) == on ]]; then
    log "Windows Vista is on: turning it off first"
    "$VISTA_MODE" off || { log "vista-mode off failed; XP not applied"; return 1; }
  fi
  if [[ ! -e $SAVED ]]; then
    save_state || { log "could not save pre-XP state; nothing applied"; return 1; }
  fi
  local s rc=0
  for s in "${STEPS[@]}"; do
    "${s}_apply" || { log "apply failed in step $s (others still applied; rerun 'xp-mode on' or 'off')"; rc=1; }
  done
  return $rc
}

cmd_off() {
  local s part rc=0
  for s in "${STEPS[@]}"; do
    part=null
    [[ -e $SAVED ]] && part=$(jq -c --arg s "$s" '.[$s]' "$SAVED")
    "${s}_restore" "$part" || { log "restore failed in step $s"; rc=1; }
  done
  if ((rc == 0)); then
    rm -f "$SAVED"
  else
    log "kept $SAVED so a rerun of 'xp-mode off' can finish the restore"
  fi
  return $rc
}

cmd_status() {
  local name=""
  [[ -r $THEME_NAME_FILE ]] && read -r name <"$THEME_NAME_FILE"
  if [[ -e $SAVED ]]; then echo on; else echo off; fi
  echo "theme: ${name:-unknown}"
  if [[ -e $SAVED ]]; then
    echo "saved-state: $SAVED ($(date -r "$SAVED" '+%F %T'))"
  else
    echo "saved-state: absent"
  fi
  if [[ ! -e $TOGGLE ]]; then
    echo "hypr toggle: absent"
  elif cmp -s "$LATE" "$TOGGLE"; then
    echo "hypr toggle: installed"
  else
    echo "hypr toggle: installed, differs from late.lua"
  fi
  echo "font-name: $(gsettings get "$SCHEMA" font-name)  monospace: $(gsettings get "$SCHEMA" monospace-font-name)"
  browser_status
  [[ -s $LOG ]] && echo "last logged error: $(tail -n 1 "$LOG")"
  return 0
}

CMD=${1:-}
USAGE="usage: xp-mode on|off|status|sizes|cleanup|browser-dark [on|off|status]"
case $CMD in
  on | off) ;;
  status) cmd_status; exit ;;
  sizes) xp_theme_active || exit 0 ;;
  cleanup) [[ -e $ZEN_PENDING ]] || exit 0 ;;
  browser-dark)
    case ${2:-status} in
      on | off) ;;
      status) browser_status; exit ;;
      *) echo "$USAGE" >&2; exit 2 ;;
    esac ;;
  *) echo "$USAGE" >&2; exit 2 ;;
esac

# Never forked or locked when there is nothing to undo: this runs on every
# non-XP theme switch.
[[ $CMD == off && ! -e $SAVED && ! -e $TOGGLE && ! -e $ZEN_PENDING ]] && exit 0

# Theme switches can overlap (omarchy-theme-set runs hooks outside its lock);
# two concurrent first `on`s could otherwise both save, the second capturing XP
# values as the "original" state.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/xp-mode.lock"
flock 9

# A Zen clean-up left pending finishes first (if Zen is closed now), so an
# `on` saves the true pre-XP state.
[[ $CMD == sizes ]] || zen_finish_pending || log "Zen clean-up still pending"
case $CMD in
  sizes) sizes_apply ;;
  cleanup) ;;
  browser-dark) cmd_browser_dark "$2" ;;
  *) "cmd_$CMD" ;;
esac
