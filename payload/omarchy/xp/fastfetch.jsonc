// Windows XP — fastfetch, laid out like XP's System Properties > General tab.
//
// xp-mode copies this over fastfetch/config.jsonc while an XP theme is active
// and moves the original back on revert (byte-for-byte). The logo is the XP
// boot screen's, rendered by fetch-assets.sh into assets/branding/about.txt,
// which xp-mode swaps into omarchy/branding/about.txt (raw truecolor
// half-blocks, hence "file-raw"). Text colours are console palette slots
// (97 bright white, 90 dark grey), so they follow the theme's colors.toml.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/omarchy/branding/about.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "",
    "key": {
      "width": 4
    }
  },
  "modules": [
    "break",
    { "type": "custom", "format": "\u001b[97mSystem:" },
    { "type": "custom", "format": "    Microsoft Windows XP" },
    { "type": "custom", "format": "    Professional" },
    { "type": "custom", "format": "    Version 2002" },
    { "type": "custom", "format": "    Service Pack 3" },
    "break",
    { "type": "custom", "format": "\u001b[97mRegistered to:" },
    { "type": "title", "key": "    ", "format": "{user-name}" },
    { "type": "title", "key": "    ", "format": "{host-name}" },
    "break",
    { "type": "custom", "format": "\u001b[97mComputer:" },
    { "type": "cpu", "key": "    ", "format": "{name}" },
    { "type": "cpu", "key": "    ", "format": "{freq-max}" },
    { "type": "memory", "key": "    ", "format": "{total} of RAM" },
    "break",
    { "type": "custom", "format": "\u001b[90mActually running:" },
    { "type": "os", "key": "    ", "format": "\u001b[90m{pretty-name}" },
    { "type": "kernel", "key": "    ", "format": "\u001b[90m{sysname} {release}" }
  ]
}
