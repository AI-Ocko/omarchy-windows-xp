#!/bin/bash
# Windows XP browser dark mode: finish a Zen clean-up left pending because Zen
# was running when dark mode ended (see xp-mode, browser step). Runs at login,
# before Zen is normally open again; without a pending marker it exits here.
[[ -e $HOME/.local/state/omarchy/xp/zen-pending ]] || exit 0
exec "$HOME/.config/omarchy/xp/bin/xp-mode" cleanup
