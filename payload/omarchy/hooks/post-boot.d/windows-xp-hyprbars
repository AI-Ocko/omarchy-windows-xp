#!/bin/bash
# After a Hyprland update the XP caption-button hyprbars can only be rebuilt
# once the new Hyprland is running, i.e. at the next login: this is that run.
# Backgrounded and a no-op when the stamp already matches (xp-hyprbars-heal).
setsid -f "$HOME/.config/omarchy/xp/bin/xp-hyprbars-heal" </dev/null >/dev/null 2>&1
exit 0
