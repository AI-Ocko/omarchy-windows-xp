[Unit]
Description=Resize the Windows XP terminal font when Omarchy's text size changes

# `omarchy display text size` rewrites both files. xp-mode sizes is a no-op
# outside an XP theme, so this can stay enabled under any theme.
[Path]
PathChanged=%h/.config/foot/foot.ini
PathChanged=%h/.config/omarchy/shell.toml
Unit=xp-sizes.service

[Install]
WantedBy=default.target
